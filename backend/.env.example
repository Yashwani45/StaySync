# ====================================================
# StaySync Backend Environment Configuration Template
# ====================================================

# Port configuration (Default: 5001)
PORT=5001

# MongoDB Connection String (MongoDB Atlas or local daemon)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/staysync

# Secret for signing JWT access tokens
JWT_SECRET=your_jwt_secret_key_here

# Runtime environment (development / production)
NODE_ENV=development

# Force using local daemon (mongodb://127.0.0.1:27017/staysync) instead of Atlas
USE_LOCAL_DB=false

# ----------------------------------------------------
# Automated Email Service Configuration (Optional)
# ----------------------------------------------------
# Web3Forms API key for serverless email dispatch
WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# SMTP / Nodemailer configuration (for transactional alerts)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="StaySync Notifications <notifications@staysync.com>"

# ----------------------------------------------------
# Payment Gateway Configuration (Optional - Razorpay)
# ----------------------------------------------------
# Test or live credentials from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
